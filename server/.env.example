# ============================================================
# Server Configuration
# ============================================================
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ============================================================
# Database Connection
# ============================================================
# Local Postgres (docker compose sets this for you)
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>?schema=public

# ============================================================
# Security — JWT Secret (REQUIRED)
# MUST be a cryptographically random string of 48+ bytes.
# Generate one:
#   node -e "require('crypto').randomBytes(48).toString('hex')"
# ============================================================
JWT_SECRET=<paste-output-of-above-command-here>

# ============================================================
# Business Logic
# ============================================================
FLAT_SHIPPING=50
FREE_SHIPPING_LIMIT=500
LOW_STOCK_THRESHOLD=5
RETURN_WINDOW_DAYS=7
RESET_TOKEN_MINUTES=30

# ============================================================
# Seed Script Credentials (used only by: npm run seed)
# Set a strong password — min 12 chars, letters + numbers + symbol
# ============================================================
ADMIN_EMAIL=admin@vibe2fix.local
ADMIN_PASSWORD=<min-12-chars-letters-numbers-symbol>
CUSTOMER_SEED_PASSWORD=<optional-override-for-demo-customer>
